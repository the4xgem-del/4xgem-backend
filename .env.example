# ── App ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_APP_URL=http://localhost:5173

# ── Database (point at RDS/Cloud SQL/Neon/etc in production) ───────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fourxgem?schema=public

# ── Redis (ElastiCache/Upstash/Redis Cloud in production) ──────────────
REDIS_URL=redis://localhost:6379

# ── JWT — generate with: openssl rand -hex 32 ──────────────────────────
JWT_ACCESS_SECRET=replace-with-64-char-random-hex-string-aaaaaaaaaaaaaaaaaaaaaaaaaaaaa
JWT_REFRESH_SECRET=replace-with-64-char-random-hex-string-bbbbbbbbbbbbbbbbbbbbbbbbbbbbb
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ── Cookies ──────────────────────────────────────────────────────────
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ── CSRF — generate with: openssl rand -hex 32 ─────────────────────────
CSRF_SECRET=replace-with-64-char-random-hex-string-ccccccccccccccccccccccccccccc

# ── Email (SES / Postmark / SendGrid — anything SMTP-compatible) ───────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="4xGem <no-reply@4xgem.com>"

# ── Object storage (S3 or S3-compatible: R2, MinIO, Backblaze) ─────────
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=4xgem-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Stripe ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Google Sign-In ──────────────────────────────────────────────────
# Create OAuth 2.0 client IDs in Google Cloud Console (APIs & Services >
# Credentials). GOOGLE_CLIENT_ID is required for the web "Continue with
# Google" button. The Android/iOS ones are optional — only needed once
# native apps exist; the same /auth/google endpoint verifies ID tokens
# from any of them.
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# ── Rate limiting ───────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

LOG_LEVEL=info

# ── Seed script (dev/staging only) ──────────────────────────────────
SEED_ADMIN_EMAIL=admin@4xgem.com
SEED_ADMIN_PASSWORD=ChangeMe123!
